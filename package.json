{
  "name": "doughkit.dev",
  "version": "1.0.0",
  "description": "Blog, portfolio, and personal site for doughkit",
  "main": "index.js",
  "repository": "https://github.com/doughkit/doughkit.dev.git",
  "author": "doughkit <doughkit@proton.me>",
  "license": "MIT",
  "private": false,
  "type": "module",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^1.1.1",
    "@11ty/eleventy-plugin-syntaxhighlight": "^2.0.3",
    "@iconify-json/ph": "^1.2.2",
    "concurrently": "^9.2.1",
    "eleventy-plugin-phosphoricons": "^2.0.0",
    "eleventy-plugin-purgecss": "^0.5.0",
    "html-minifier-next": "^4.17.1",
    "js-yaml": "^4.1.1",
    "purgecss": "^7.0.2",
    "stylus": "^0.64.0",
    "yarn": "^1.22.22"
  },
  "scripts": {
    "build:stylus": "npx stylus --compress ./src/styles/ --out ./_site/css/",
    "watch:stylus": "npx stylus --watch ./src/styles/ --out ./_site/css/",
    "build:11ty": "eleventy",
    "watch:11ty": "eleventy --serve",
    "build": "npm run build:stylus && npm run build:11ty",
    "serve": "npx concurrently \"yarn watch:stylus\" \"yarn watch:11ty\""
  }
}
