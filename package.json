    "@11tyrocks/eleventy-plugin-sass-lightningcss": "^1.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "daisyui": "^5.5.14",
    "eleventy-plugin-phosphoricons": "^2.0.0",
    "eleventy-plugin-purgecss": "^0.5.0",
    "eleventy-plugin-vento": "^5.3.0",
    "html-minifier-next": "^4.17.1",
    "js-yaml": "^4.1.1",
    "pug": "^3.0.3",
    "purgecss": "^7.0.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "tail": "yarn exec tailwindcss -- -i src/styles/tailwind.css -c src/styles/tailwind.config.js -o _site/style.css -m",
    "build": "NODE_ENV=production yarn exec eleventy & yarn tail",
    "serve": "yarn exec eleventy -- --serve & yarn tail --watch --poll"
